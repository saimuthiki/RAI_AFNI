__pycache__/
*.pyc

# Virtual environments. docs/setup.md now tells you to create `.venv` INSIDE the
# clone, so this rule is load-bearing rather than housekeeping: without it, a
# `git add -A` after following the setup guide stages a few hundred MB of
# site-packages. `.venv` is the name the guide uses; the others are here because
# somebody will use their own.
.venv/
venv/
env/
.python-version

# Local, machine-specific Claude Code settings (the shared wiring in
# .claude/settings.json, .claude/helpers/ and .claude/skills/ IS committed).
# Note: the reference repos' own .claude/ folders under references/ ARE tracked
# deliberately, as part of the reference material - see commit 6d8da14.
.claude/settings.local.json

# Secrets. Provider keys are supplied by environment, never committed. A key
# that reaches a commit is public and permanent, and rotating it is the only
# remedy - so this rule comes before anything can go wrong, not after.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Regenerable context caches — each dev builds their own (like node_modules)
graft/
graphify-out/

# Runtime artefacts
afni_audit.sqlite
afni_audit.sqlite-shm
afni_audit.sqlite-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Redirected command output. `> output.txt` while debugging is normal; committing
# it is not - and on Windows PowerShell writes it as UTF-16, which reads as
# binary noise in a diff.
output.txt
*.out
*.log

# --------------------------------------------------------------------------- #
# references/ holds 23 open-source repos read at SOURCE level. Every rail cites
# a `references/<repo>/<file>:<line>` as its evidence, so the source files are
# load-bearing - they are what makes a ported pattern auditable.
#
# The non-source payload is not. On 2026-09-03 it was 1,643 MB across 2,527
# files - model weights, conference slide decks, notebooks with embedded
# outputs, sample DICOMs, a 13 MB screencast - and NOT ONE of the 49 cited paths
# pointed at any of it. Deleted, and ignored here so re-extracting a reference
# repo does not put it back.
#
# If you ever need one of these blobs, fetch it from the upstream project. Do
# not commit it.
references/**/*.pkl
references/**/*.pickle
references/**/*.pth
references/**/*.pt
references/**/*.joblib
references/**/*.caffemodel
references/**/*.npy
references/**/*.npz
references/**/*.h5
references/**/*.hdf5
references/**/*.onnx
references/**/*.safetensors
references/**/*.bin
references/**/*.png
references/**/*.jpg
references/**/*.jpeg
references/**/*.gif
references/**/*.bmp
references/**/*.tiff
references/**/*.ico
references/**/*.webp
references/**/*.mp4
references/**/*.mov
references/**/*.avi
references/**/*.webm
references/**/*.mp3
references/**/*.wav
references/**/*.pptx
references/**/*.ppt
references/**/*.pdf
references/**/*.docx
references/**/*.xlsx
references/**/*.zip
references/**/*.tar
references/**/*.gz
references/**/*.tgz
references/**/*.whl
references/**/*.jar
references/**/*.ipynb
references/**/*.woff
references/**/*.woff2
references/**/*.ttf
references/**/*.eot
references/**/*.otf
references/**/*.dcm
references/**/*.tab
references/**/*.html
references/**/*.parquet
references/**/*.sqlite

# NOTE 2026-09-03, second pass: these were briefly stripped and then RESTORED at
# AFNI's instruction — "don't modify or delete any folders in the references"
# beyond the large files. The rules below are therefore commented out.
#
# What they were: 22 Infosys .env files (templates full of ${placeholder}, no
# real values), promptfoo's example keypair (a test fixture published in its own
# public repo), a helm secret.yaml template and an llm_connection_credentials.json.
# None was an AFNI secret; all are third-party repo contents.
#
# The one consequence to know: a secret scanner pointed at this repository WILL
# flag the .env and .pem files. They are not live credentials, but somebody will
# have to say so. Uncomment these lines if that becomes tiresome.
#
# references/**/.env
# references/**/*.pem
# references/**/*.p12
# references/**/*.pfx
# references/**/*.key
# references/**/secret.yaml
# references/**/*credentials*.json

# The topic policy is per-DEPLOYMENT state, not source. Which topics a given
# AFNI application refuses differs by application, so committing one would push
# one deployment's choices onto every other. The six ALWAYS topics that must
# hold everywhere are in afni_rai/topics.py, in code, on purpose.
afni_topic_policy.json
**/afni_topic_policy.json

# The threshold policy is per-DEPLOYMENT state for the same reason. The shipped
# defaults live in afni_rai/tenets/accountability/thresholds.py, each cited to
# the repository it was ported from; this file is only what one deployment has
# tuned on top of them, learned from its own traffic.
afni_thresholds.json
**/afni_thresholds.json
