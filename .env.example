# AFNI Responsible AI gateway - configuration template.
#
#   cp .env.example .env      then fill in the values
#
# `.env` is gitignored. Never commit a real key: a key that reaches a commit is
# public and permanent, and rotating it is the only remedy. If one ever does,
# rotate first and clean history second.

# ---------------------------------------------------------------------------
# Stage-3 judge providers
# ---------------------------------------------------------------------------
# An ORDERED fallback chain. The gateway tries each provider in turn, and each
# key within a provider in turn, moving on only when a call fails for an
# infrastructural reason - auth rejected, rate limited, timeout, 5xx. It does
# NOT fall through on a low score: a judge returning 0.1 is an answer, not a
# failure, and retrying it against another key would be shopping for a verdict.
#
# When the whole chain is exhausted, every judge rail returns `unjudged`, which
# fails closed on client-facing traffic. That is deliberate. There is no
# guessed-score fallback anywhere in this platform.
AFNI_JUDGE_PROVIDER=openai,gemini

# Opt-in, default off. When true, the gateway probes the local endpoint ONCE at
# startup (a cheap GET /models, 2 s timeout) and, if it answers, puts `local` at
# the front of the chain - inserting it if the chain above does not name it.
# Falls back to the chain above, in the order above, whenever the endpoint is
# down.
#
# Why opt-in rather than automatic: chain order decides where the FLAGGED
# CONTENT in a judge call is sent, so it is a data-residency decision and has to
# be typed out rather than inferred.
#
# The probe cannot stop the gateway booting - a local endpoint that does not
# answer is a warning and the configured order stands. The reordering, its
# reason, and the probe result are reported at /healthz under
# judge_provider.prefer_local.
#
# When LOCAL_BASE_URL is unset and AFNI_TARGET_BASE_URL is set, the local judge
# inherits the target's endpoint and model - that being the machine you just
# pointed this gateway at. Reported as inherited_from_target: true.
# AFNI's decision: local FIRST, paid keys only as the fallback. The probe cannot
# fail a boot, so with the VPN down this simply leaves the chain as openai,gemini.
AFNI_JUDGE_PREFER_LOCAL=true
AFNI_JUDGE_PREFER_LOCAL_TIMEOUT=2

# --- OpenAI (also covers Azure OpenAI and any OpenAI-compatible gateway) ----
# Comma-separated, tried in order. Two keys means the second covers the first
# being rate limited or revoked.
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
# UNVERIFIED DEFAULT: no call has been made from the build environment (its
# proxy blocks outbound provider traffic), so confirm this model id is enabled
# on your account before relying on it.
OPENAI_MODEL=gpt-4o-mini

# --- Google AI Studio / Gemini ---------------------------------------------
GOOGLE_API_KEYS=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# UNVERIFIED DEFAULT - same caveat as above.
GOOGLE_MODEL=gemini-flash-latest

# --- Local inference (Ollama / vLLM / llama.cpp, OpenAI-compatible) --------
# Leave blank until the endpoint is up. Put `local` first in
# AFNI_JUDGE_PROVIDER to prefer it - judge calls send the FLAGGED CONTENT to
# whichever provider serves them, so a local endpoint is the only option that
# keeps that content on your own network.
LOCAL_BASE_URL=
LOCAL_MODEL=

# Per-call timeout, seconds. A judge is Stage 3, so it is already the slow path;
# this bounds how slow. On timeout the chain moves to the next key.
AFNI_JUDGE_TIMEOUT=20

# ---------------------------------------------------------------------------
# The TARGET - the AI system this gateway guards
# ---------------------------------------------------------------------------
# This is what turns the gateway from "judges text you hand it" into "sits in
# front of your model". With these set, POST /v1/chat guards the prompt, calls
# this endpoint, guards the completion, and returns all four steps.
#
# Any OpenAI-compatible chat endpoint: vLLM, Ollama, llama.cpp, LM Studio,
# LiteLLM, or OpenAI itself. One POST to {base_url}/chat/completions, made with
# httpx - the `openai` SDK is deliberately not a dependency of this platform.
#
# Leave AFNI_TARGET_BASE_URL blank and nothing breaks: /v1/chat returns a 503 in
# the standard error shape naming these variables, and /v1/guard and every
# introspection endpoint work exactly as before.
# AFNI's demo endpoint. Reachable only with the corporate VPN connected: it is a
# private 10.x address, so nothing outside that network - including the build
# environment this file was written in - can reach it. With the VPN down you get
# a startup WARNING and /v1/chat returns decision=target_error; /v1/guard, the
# console and every introspection endpoint carry on unaffected.
AFNI_TARGET_BASE_URL=http://10.10.10.151:8506/v1
# UNVERIFIED: there is no default, and no call has been made against this id
# from the build environment - its egress cannot reach a private address. A
# wrong id is a 404 per request, which reads like an outage, so this is required
# rather than guessed. /healthz reports whether the endpoint's own /models
# listing confirmed it.
AFNI_TARGET_MODEL=qwen3-vl-8b-instruct
# Optional - a local inference server usually has no auth. When absent no
# Authorization header is sent at all, rather than one carrying an empty string.
# This value is never logged, never in an error message, and never in /healthz,
# which reports only the boolean api_key_configured.
# AFNI's demo endpoint expects `test-key-123`. It is deliberately NOT written
# here: this file is committed, and a habit of committing a key that happens to
# be low-value is the habit that commits one that is not. Put it in .env, which
# is gitignored.
AFNI_TARGET_API_KEY=
# Per-call timeout, seconds. A generation is slower than a judge call, hence 60.
# On timeout /v1/chat returns decision=target_error with NO completion.
AFNI_TARGET_TIMEOUT=60
# Optional cap on the completion, omitted from the request when blank.
AFNI_TARGET_MAX_TOKENS=
# The STARTUP reachability probe only, seconds. Separate from the call timeout
# because a 60-second generation budget is reasonable and a 60-second boot delay
# because a model server is down is not. /healthz reports what this probe found
# and does NOT repeat it per hit.
AFNI_TARGET_PROBE_TIMEOUT=2

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
AFNI_HOST=127.0.0.1
AFNI_PORT=8000

# Where the audit trail is written. Every verdict lands here in the
# OpenGuardrails schema. Matched values are NEVER stored - only a fingerprint.
AFNI_AUDIT_DB=./afni_audit.sqlite

# Danger switch, default off. When true, explanations include the matched value
# (the actual SSN, the actual API key) instead of its fingerprint. It is a
# SERVER-side flag and deliberately not a request parameter: a caller must never
# be able to ask the gateway to echo back the secret it just caught. Turn it on
# only for local debugging, never in an environment that logs responses.
AFNI_REVEAL_SUBJECT=false

# ---------------------------------------------------------------------------
# Stage-2 local models (optional)
# ---------------------------------------------------------------------------
# The Stage-2 rails load pinned HuggingFace models through transformers/torch.
# Without them installed those rails report `unjudged` and fail closed, which is
# honest but not protection. Install with:
#
#   pip install transformers torch llm-guard==0.3.16 presidio-analyzer
#
# llm-guard is PINNED on purpose: Protect AI archived the repo, so no upstream
# fix will arrive and an unpinned install of an abandoned package is a standing
# supply-chain risk. 0.3.16 is the version this platform's rails were written
# against, and the version vendored under references/.
#   python -m spacy download en_core_web_lg
#
# Set this to keep a rail from reaching the network mid-request: weights must
# already be in the local HF cache or the rail reports unjudged rather than
# downloading during a live call.
HF_HUB_OFFLINE=0

# Where the dropped-in model folders live. Defaults to rai_platform/models.
# Point it elsewhere to keep ~2.8 GB of weights off the project drive - the
# weights are gitignored and must never be committed (GitHub rejects any file
# over 100 MB outright, so three of the five would fail the push regardless).
#   Windows:  AFNI_MODEL_DIR=D:\Afni\RAI_AFNI-main\rai_platform\models
AFNI_MODEL_DIR=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# How loudly the VENDORED libraries log - llm-guard, transformers, presidio,
# spaCy. Default ERROR, and that default is a privacy decision as much as a
# readability one.
#
# llm-guard logs the full per-label score vector for every text it scans, at
# DEBUG, through an unconfigured structlog. Those labels include `muslim`,
# `jewish`, `black`, `white`, `homosexual_gay_or_lesbian` - so the default
# behaviour is a 16-dimensional inference about protected characteristics
# written to stdout for every message the gateway sees, by a component of a
# platform whose own audit trail deliberately stores no matched text at all.
#
# It is also unreadable: a test run on a provisioned machine produced 174 lines
# of output in which the test summary did not appear.
#
# This platform's audit trail is the record of record - structured, queryable,
# and storing fingerprints rather than content. Set DEBUG to restore the
# original vendor behaviour when debugging a model.
AFNI_THIRD_PARTY_LOG_LEVEL=ERROR
