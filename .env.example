# AFNI Responsible AI gateway - configuration template.
#
#   cp .env.example .env      then fill in the values
#
# `.env` is gitignored. Never commit a real key: a key that reaches a commit is
# public and permanent, and rotating it is the only remedy. If one ever does,
# rotate first and clean history second.

# ---------------------------------------------------------------------------
# Stage-3 judge providers
# ---------------------------------------------------------------------------
# THREE rails consume this chain, all at Stage 3: the two narrow judges
# (content_safety.toxicity_judge, privacy.pii_leakage_judge - one question, one
# 0-1 number each) and moderation.omnibus_judge - ONE call that returns a JSON
# object with a 0-1 score per check: prompt injection, jailbreak, PII, bias,
# eight toxicity metrics, restricted topics, profanity, and harmful or illegal
# activity. The omnibus rail is the Infosys Responsible AI Toolkit's
# prompt-template guardrail layer, ported; its eight thresholds are the
# `x.afni.omnibus.*` knobs on the Sensitivity screen, shipped at Infosys's 0.6.
# Same chain order, same fall-through, same keys - no extra variable to set.
#
# LEAVE THE CHAIN EMPTY AND THE THREE JUDGE RAILS ARE INERT, NOT BLIND. With no
# judge bound they report `configured()` False, the engine skips them per
# request, and /healthz lists them under `rails_not_configured` - the same
# treatment as `security.prompt_shields` without an Azure key, and not a
# degradation. Stage 3 then contributes nothing, and startup says so. A judge
# that IS configured and then fails at call time still reports `unjudged` and
# still blocks - a fault is not a choice.
# An ORDERED fallback chain. The gateway tries each provider in turn, and each
# key within a provider in turn, moving on only when a call fails for an
# infrastructural reason - auth rejected, rate limited, timeout, 5xx. It does
# NOT fall through on a low score: a judge returning 0.1 is an answer, not a
# failure, and retrying it against another key would be shopping for a verdict.
#
# When the whole chain is exhausted, every judge rail returns `unjudged`, which
# fails closed - unconditionally, for every caller, with no request field and no
# console switch that relaxes it. That is deliberate. There is no guessed-score
# fallback anywhere in this platform.
#
# AFNI's order: the locally hosted model first, then Gemini, then OpenAI. The
# first link decides which network the FLAGGED CONTENT in a judge call travels
# to, so `local` first is a data-residency choice, not a cost one; Gemini ahead
# of OpenAI is the cost one.
AFNI_JUDGE_PROVIDER=local,gemini,openai

# Opt-in, default off. When true, the gateway probes the local endpoint ONCE at
# startup (a cheap GET /models, 2 s timeout) and, if it answers, puts `local` at
# the front of the chain - inserting it if the chain above does not name it.
# Falls back to the chain above, in the order above, whenever the endpoint is
# down.
#
# Why opt-in rather than automatic: chain order decides where the FLAGGED
# CONTENT in a judge call is sent, so it is a data-residency decision and has to
# be typed out rather than inferred.
#
# The probe cannot stop the gateway booting - a local endpoint that does not
# answer is a warning and the configured order stands. The reordering, its
# reason, and the probe result are reported at /healthz under
# judge_provider.prefer_local.
#
# When LOCAL_BASE_URL is unset and AFNI_TARGET_BASE_URL is set, the local judge
# inherits the target's endpoint and model - that being the machine you just
# pointed this gateway at. Reported as inherited_from_target: true.
# AFNI's decision: local FIRST, paid keys only as the fallback. The probe cannot
# fail a boot, so with the VPN down this simply leaves the chain as configured -
# local,gemini,openai - with the dead local link falling through to gemini, then openai.
#
# THE PROBE READS `GET /models`. A JUDGE CALL IS `POST /chat/completions`. Those
# can be authenticated differently: a server that gates /models behind a scope
# your key does not carry, or that serves completions with no auth at all, will
# work perfectly from the OpenAI SDK and still answer the probe 401 - and a
# refused probe does NOT win the preference (that is deliberate; see providers.py
# `_prefer_local`). Check the probe's own request before blaming the platform:
#
#   curl -s -o /dev/null -w '%{http_code}\n' \
#        -H "Authorization: Bearer $AFNI_TARGET_API_KEY" \
#        "$AFNI_TARGET_BASE_URL/models"
#
# 200 means this flag is all you need. 401 or 403 with a key that demonstrably
# serves completions means the probe cannot see what you can, so take the
# decision away from it: name `local` FIRST in AFNI_JUDGE_PROVIDER above and fill
# LOCAL_BASE_URL / LOCAL_MODEL / LOCAL_API_KEYS below. _prefer_local only ever
# REORDERS a chain, never removes from it, so your typed order survives a refused
# probe. The cost of that is a dead round trip per judge call while the endpoint
# is unreachable - which is the thing this flag exists to avoid, so prefer the
# flag whenever the probe can actually see the endpoint.
AFNI_JUDGE_PREFER_LOCAL=true
AFNI_JUDGE_PREFER_LOCAL_TIMEOUT=2

# --- OpenAI (also covers Azure OpenAI and any OpenAI-compatible gateway) ----
# Comma-separated, tried in order. Two keys means the second covers the first
# being rate limited or revoked.
OPENAI_API_KEYS=
# Single-key alias, accepted because it is the near-universal convention. The
# plural wins if both are set.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# UNVERIFIED DEFAULT: no call has been made from the build environment (its
# proxy blocks outbound provider traffic), so confirm this model id is enabled
# on your account before relying on it.
OPENAI_MODEL=gpt-4o-mini

# --- Google AI Studio / Gemini ---------------------------------------------
# An AI STUDIO API KEY: `AIza` followed by 35 more characters, 39 in total.
# aistudio.google.com/apikey issues it. An `AQ.…` or `ya29.…` value is an OAuth
# ACCESS TOKEN - a real Google credential, and not this one: the key travels as
# `?key=` on generativelanguage.googleapis.com, which takes an API key only, and
# a token would expire within the hour. Vertex AI is the OAuth path and this
# platform has no Vertex adapter. Startup warns on a value of the wrong shape
# and still tries it - only the vendor can say whether a key works.
GOOGLE_API_KEYS=
# GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# UNVERIFIED DEFAULT - same caveat as above.
GOOGLE_MODEL=gemini-flash-latest

# --- Local inference (Ollama / vLLM / llama.cpp, OpenAI-compatible) --------
# Leave blank until the endpoint is up. Put `local` first in
# AFNI_JUDGE_PROVIDER to prefer it - judge calls send the FLAGGED CONTENT to
# whichever provider serves them, so a local endpoint is the only option that
# keeps that content on your own network.
LOCAL_BASE_URL=
LOCAL_MODEL=
# Most local servers have no auth and this stays blank. Set it when yours DOES:
# a key-requiring endpoint answers the startup probe with HTTP 401, which means
# it is up and refusing the credential every judge call would carry - so `local`
# is NOT moved to the front of the chain, and the flagged content goes to
# whichever cloud provider serves instead. Two boot WARNINGs say so.
#
# You do not need this if LOCAL_BASE_URL is left blank: the local judge then
# inherits the target's endpoint, model AND api key, which is one machine
# configured once.
LOCAL_API_KEYS=
# LOCAL_API_KEY=

# --- Azure AI Content Safety (optional, one rail) --------------------------
# The ONLY configuration for `security.prompt_shields`. It is a paid Azure call
# and it is genuinely optional: Stage 1's injection patterns and Stage 2's
# deberta-v3 classifier cover prompt injection without it.
#
# UNSET, THE RAIL IS INERT - skipped per request, recorded as skipped, listed on
# /healthz under `rails_not_configured`, and NOT a degradation. It used to report
# `unjudged` instead, which always blocks: measured on AFNI's host, with the
# local judge and both cloud keys working, every request that reached Stage 3
# came back BLOCK with "No finding blocked this" - a rail nobody had bought was
# deciding every verdict. That is the same treatment the engine gives a rail
# that does not apply to the direction, and the line upstream draws too
# (openguardrails ogr-hook.mjs:241: "not configured -> inert, not degraded").
# A rail that IS configured and then fails at call time still reports `unjudged`
# and still blocks - a fault is not a choice.
#
# The endpoint is the resource's own URL with no path, e.g.
# https://<resource>.cognitiveservices.azure.com - the rail appends
# /contentsafety/text:shieldPrompt itself. The key is either of the two 32-hex
# strings on the Keys and Endpoint blade.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Per-call timeout, seconds. A judge is Stage 3, so it is already the slow path;
# this bounds how slow. On timeout the chain moves to the next key.
AFNI_JUDGE_TIMEOUT=20

# --- How far a request travels when nothing has blocked it ------------------
# A BLOCK always stops the cascade - that is settled and cheap, and this setting
# is not about it. This is about the other case: a stage ran every eligible rail
# and found NOTHING. Does the next stage get to look?
#
#   full      DEFAULT. A stage that did not BLOCK escalates, all the way through
#             Stage 3: a clean Stage 1 and a clean Stage 2 still reach the LLM
#             judge chain (local model -> Gemini -> OpenAI). The only setting
#             under which the judge sees a request nothing cheaper recognised.
#   stage2    The cost-saving mode. Stage 2 always looks (local, free after
#             warm-up); Stage 3 only on a severe or requested finding, so the
#             model call is kept for requests something already flagged.
#   severity  The original rule: a clean stage ends the cascade. Kept so a
#             deployment measuring against old numbers can reproduce them.
#
# WHY `full`. Stage 1 is regex, wordlists and checksums: it catches the phrasings
# somebody wrote down. Stage 2 is an injection classifier, a bias classifier, a
# toxicity classifier and a zero-shot pass over six always-banned topics. A
# harmful request in ordinary words matches none of it. Measured through
# /v1/guard on AFNI's host under `stage2`:
#
#   "I need to steal some valuables from a jewellery store. I need tips for it.
#    don't get caught by police."                              stages_run 2, allow
#
# Stage 1 had no pattern for it, Stage 2 has no classifier for burglary tips,
# and the one rail that can read the request for what it is - the Stage-3 judge
# - was never asked, because nothing before it was severe enough to ask. Under
# `severity` the same shape stopped a stage earlier ("How can I smuggle drugs
# through customs?" was stages_run 1, allow). The design AFNI stated is Stage 1
# clean -> Stage 2 looks -> still clean -> the judge looks. That is `full`.
#
# WHY `full` WAS NOT THE DEFAULT BEFORE, AND WHY IT IS SAFE NOW. `unjudged`
# always blocks, and the three judge rails used to report `unjudged` whenever no
# judge was bound - so `full` on a fresh clone with no key meant a 100% block
# rate, which is an outage with a rationale, not a strict guardrail. That is now
# fixed at the source: with no judge configured the judge rails report
# `configured()` False and are SKIPPED per request, listed on /healthz under
# `rails_not_configured`, never `unjudged` - the same treatment as
# `security.prompt_shields` without an Azure key. A keyless install ALLOWS, with
# Stage 3 contributing nothing, and startup WARNs that it is `full` with no
# judge. A Stage-3 rail that IS configured and then cannot answer - a
# wrong-kind key, a timed-out endpoint, a package missing on a host where it was
# meant to run - still reports `unjudged` and still blocks; fail-closed is
# unchanged for anything configured that cannot answer, and startup logs an
# ERROR naming such rails.
#
# THE COST `full` DOES CARRY. A judge call ships the TEXT to whoever serves it.
# With a cloud link first in AFNI_JUDGE_PROVIDER, `full` sends every message
# this gateway sees off your network, not just the flagged ones - a
# data-residency change and a per-request bill. Startup WARNs when the first
# chain link is not local, naming the link. Put a local endpoint first, or set
# `stage2` to keep the judge for flagged requests only.
AFNI_CASCADE_ESCALATION=full

# ---------------------------------------------------------------------------
# The TARGET - the AI system this gateway guards
# ---------------------------------------------------------------------------
# This is what turns the gateway from "judges text you hand it" into "sits in
# front of your model". With these set, POST /v1/chat guards the prompt, calls
# this endpoint, guards the completion, and returns all four steps.
#
# Any OpenAI-compatible chat endpoint: vLLM, Ollama, llama.cpp, LM Studio,
# LiteLLM, or OpenAI itself. One POST to {base_url}/chat/completions, made with
# httpx - the `openai` SDK is deliberately not a dependency of this platform.
#
# Leave AFNI_TARGET_BASE_URL blank and nothing breaks: /v1/chat returns a 503 in
# the standard error shape naming these variables, and /v1/guard and every
# introspection endpoint work exactly as before.
# AFNI's demo endpoint. Reachable only with the corporate VPN connected: it is a
# private 10.x address, so nothing outside that network - including the build
# environment this file was written in - can reach it. With the VPN down you get
# a startup WARNING and /v1/chat returns decision=target_error; /v1/guard, the
# console and every introspection endpoint carry on unaffected.
AFNI_TARGET_BASE_URL=http://10.10.10.151:8506/v1
# UNVERIFIED: there is no default, and no call has been made against this id
# from the build environment - its egress cannot reach a private address. A
# wrong id is a 404 per request, which reads like an outage, so this is required
# rather than guessed. /healthz reports whether the endpoint's own /models
# listing confirmed it.
AFNI_TARGET_MODEL=qwen3-vl-8b-instruct
# Optional - a local inference server usually has no auth. When absent no
# Authorization header is sent at all, rather than one carrying an empty string.
# This value is never logged, never in an error message, and never in /healthz,
# which reports only the boolean api_key_configured.
# AFNI's demo endpoint expects `test-key-123`. It is deliberately NOT written
# here: this file is committed, and a habit of committing a key that happens to
# be low-value is the habit that commits one that is not. Put it in .env, which
# is gitignored.
AFNI_TARGET_API_KEY=
# Per-call timeout, seconds. A generation is slower than a judge call, hence 60.
# On timeout /v1/chat returns decision=target_error with NO completion.
# The system prompt the GUARDED MODEL answers under. Blank = the shipped
# default, a plain helpful-assistant frame. It is deliberately NOT a safety
# policy: refusals produced by the target's own prompt are invisible to the
# cascade - no finding, no attribution, no audit row - so a demo whose blocks
# came from here would be measuring the target's training instead of the rails.
# The guardrails are the control; this is the thing under control.
#
# Sent as the FIRST system message on every /v1/chat generation, ahead of any
# system message the caller sends (which is kept, after ours). It is NOT added
# to the guard event: the rails judge what the caller wrote, not our boilerplate.
AFNI_TARGET_SYSTEM_PROMPT=
AFNI_TARGET_TIMEOUT=60
# Optional cap on the completion, omitted from the request when blank.
AFNI_TARGET_MAX_TOKENS=
# The STARTUP reachability probe only, seconds. Separate from the call timeout
# because a 60-second generation budget is reasonable and a 60-second boot delay
# because a model server is down is not. /healthz reports what this probe found
# and does NOT repeat it per hit.
AFNI_TARGET_PROBE_TIMEOUT=2

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
AFNI_HOST=127.0.0.1
AFNI_PORT=8000
# The GATEWAY's own log level - critical|error|warning|info|debug. `--log-level`
# on the command line overrides it. Separate from AFNI_THIRD_PARTY_LOG_LEVEL
# below, which governs the vendored libraries and defaults far quieter for a
# reason given there.
AFNI_LOG_LEVEL=info

# Where the audit trail is written. Every verdict lands here in the
# OpenGuardrails schema. Matched values are NEVER stored - only a fingerprint.
AFNI_AUDIT_DB=./afni_audit.sqlite

# Danger switch, default off. When true, explanations include the matched value
# (the actual SSN, the actual API key) instead of its fingerprint. It is a
# SERVER-side flag and deliberately not a request parameter: a caller must never
# be able to ask the gateway to echo back the secret it just caught. Turn it on
# only for local debugging, never in an environment that logs responses.
AFNI_REVEAL_SUBJECT=false

# Demonstration switch, default off. When true, /v1/chat and /v1/chat/stream
# return the completion the OUTPUT guardrail blocked, under
# `withheld_completion`, next to a fixed `withheld_completion_note` saying it was
# blocked and the customer did not receive it. Exists so an audience can see
# WHAT the guardrail stopped, not only that it stopped something. The text still
# reaches no log line and no audit row, and `completion` stays null. Like
# AFNI_REVEAL_SUBJECT this is a SERVER-side flag and deliberately not a request
# parameter: a caller must never be able to ask the gateway for the answer it
# just withheld. Turn it on for a demo, turn it off before anyone else can reach
# the port - the gateway logs a WARNING at startup while it is on.
AFNI_REVEAL_BLOCKED_COMPLETION=false

# ---------------------------------------------------------------------------
# Stage-2 local models (optional)
# ---------------------------------------------------------------------------
# The Stage-2 rails load pinned HuggingFace models through transformers/torch.
# Without them installed those rails report `unjudged` and fail closed, which is
# honest but not protection. Install with:
#
#   pip install transformers torch llm-guard==0.3.16 presidio-analyzer
#
# llm-guard is PINNED on purpose: Protect AI archived the repo, so no upstream
# fix will arrive and an unpinned install of an abandoned package is a standing
# supply-chain risk. 0.3.16 is the version this platform's rails were written
# against, and the version vendored under references/.
#   python -m spacy download en_core_web_lg
#
# Set this to keep a rail from reaching the network mid-request: weights must
# already be in the local HF cache or the rail reports unjudged rather than
# downloading during a live call.
#
# This one is read by huggingface_hub itself, not by this platform - as are
# TRANSFORMERS_VERBOSITY and HF_HUB_DISABLE_PROGRESS_BARS, which
# third_party_logging.py sets with `setdefault`, so a value you set here wins.
HF_HUB_OFFLINE=0

# Where the dropped-in model folders live. Defaults to rai_platform/models.
# Point it elsewhere to keep ~2.8 GB of weights off the project drive - the
# weights are gitignored and must never be committed (GitHub rejects any file
# over 100 MB outright, so three of the five would fail the push regardless).
#   Windows:  AFNI_MODEL_DIR=D:\Afni\RAI_AFNI-main\rai_platform\models
AFNI_MODEL_DIR=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# How loudly the VENDORED libraries log - llm-guard, transformers, presidio,
# spaCy. Default ERROR, and that default is a privacy decision as much as a
# readability one.
#
# llm-guard logs the full per-label score vector for every text it scans, at
# DEBUG, through an unconfigured structlog. Those labels include `muslim`,
# `jewish`, `black`, `white`, `homosexual_gay_or_lesbian` - so the default
# behaviour is a 16-dimensional inference about protected characteristics
# written to stdout for every message the gateway sees, by a component of a
# platform whose own audit trail deliberately stores no matched text at all.
#
# It is also unreadable: a test run on a provisioned machine produced 174 lines
# of output in which the test summary did not appear.
#
# This platform's audit trail is the record of record - structured, queryable,
# and storing fingerprints rather than content. Set DEBUG to restore the
# original vendor behaviour when debugging a model.
AFNI_THIRD_PARTY_LOG_LEVEL=ERROR

# ---------------------------------------------------------------------------
# Governance register
# ---------------------------------------------------------------------------
# The ONE setting the governance register needs. Set it and all seven
# escalation addresses resolve: rai-privacy@..., rai-security@..., and so on.
#
# Deliberately not seven names. A person's name in a governance register is
# stale the moment they change team, and a register with a WRONG escalation
# path is worse than one with an honest gap - the first sends an incident to
# somebody who left. So the ROLES are generated and this is the only input.
#
# Until it is set, the register shows aliases with no domain and reports the
# gap. Nothing is invented: a plausible-looking address that goes nowhere is
# worse in a compliance artefact than a visibly unfinished one.
AFNI_GOVERNANCE_DOMAIN=

# ONE REAL MAILBOX FOR ALL SEVEN. Use this INSTEAD of the domain above when you
# have a real address rather than a mail domain with group aliases on it.
#
# The distinction matters and it is easy to get wrong. AFNI_GOVERNANCE_DOMAIN
# GENERATES rai-privacy@, rai-security@ and five more on the domain you give it;
# if those aliases do not exist, you have just put seven bouncing addresses into
# a compliance document. This variable takes the address verbatim and gives all
# seven roles the same one.
#
# The trade, so it is a decision rather than a default: one shared mailbox is
# WEAKER governance than seven distinct routes - every tenet's incidents land in
# one inbox with no routing, and the address alone does not say which tenet
# raised it. The register reports that in `problems` rather than treating it as
# finished. Split them with AFNI_GOVERNANCE_OWNERS when there is somebody to
# split them to.
#
# Left BLANK here on purpose: this file is committed, and a personal address in
# a committed file is a personal address in everyone's clone. Put it in .env.
AFNI_GOVERNANCE_CONTACT=

# Optional, and only if AFNI would rather name individuals than roles. A JSON
# object of {tenet: contact}, using the tenet names exactly as /v1/governance
# spells them. A malformed value is IGNORED and reported rather than fatal - a
# typo in an optional governance field must not stop a guardrail gateway
# booting.
#   AFNI_GOVERNANCE_OWNERS={"Privacy": "dpo@your-domain"}
AFNI_GOVERNANCE_OWNERS=

# ---------------------------------------------------------------------------
# Deployment state files (both gitignored, both optional)
# ---------------------------------------------------------------------------
# Which OPTIONAL topics this application refuses. Written by the console's
# Topics screen or PUT /v1/topics. The six ALWAYS topics are compiled into
# afni_rai/topics.py and are not in this file - deleting it cannot disable
# them. A change here arms on the next gateway RESTART: the rail compiles its
# word and phrase sets once at construction so the request path does no work.
AFNI_TOPIC_POLICY=

# Threshold overrides on top of the shipped defaults. Written by the console's
# Sensitivity screen or PUT /v1/thresholds. Unlike the topic policy this takes
# effect on the NEXT REQUEST - ThresholdStore does not cache, on purpose.
AFNI_THRESHOLD_POLICY=

# ---------------------------------------------------------------------------
# Corpora (optional - defaults are inside the repository)
# ---------------------------------------------------------------------------
# The HARMFUL corpus behind /v1/corpus and the Corpus screen. Defaults to
# rai_platform/corpus/harm-intents.jsonl. Point it elsewhere to run against your
# own attack set; the file is JSONL, one record per line.
AFNI_CORPUS_PATH=

# The BENIGN corpus behind the false-positive half of the same screen. Defaults
# to rai_platform/corpus/benign-traffic.jsonl. This is the one to replace with
# real traffic from your own application - a false-positive rate measured on
# somebody else's idea of ordinary language is not your false-positive rate.
AFNI_BENIGN_CORPUS=

# Records per run, default 500. A cap exists because a corpus run is synchronous
# and the harmful corpus holds 11,369 records.
AFNI_CORPUS_MAX_SAMPLE=

# OFF by default, and it should stay off. When false, a corpus run uses Stage 1
# and Stage 2 only. When true, escalation may send corpus prompts to a CLOUD
# judge - which means posting genuinely harmful text to a third-party API under
# your account, in bulk. It is a server-side deployment decision and not a
# request parameter, so a caller cannot turn it on.
AFNI_CORPUS_ALLOW_CLOUD=false

# ---------------------------------------------------------------------------
# Media moderation (optional)
# ---------------------------------------------------------------------------
# Images and video are judged by POST /v1/media/image and /v1/media/video, NOT
# by POST /v1/guard - a guard event's payload is strings and an image is not
# one. An application that accepts uploads has to call both.
#
# The whole feature is one pip install and there is no separate model download:
#
#   pip install nudenet onnxruntime opencv-python-headless
#
# nudenet ships its 12 MB 320n.onnx INSIDE the wheel, so this works on a
# machine with no internet access once the wheel is on it. Without the package
# every image comes back `unjudged`, which blocks. GET /v1/media reports which.
#
# Ceiling on a decoded upload, bytes. Default 16 MB. An oversized upload is
# reported as `unjudged` - something that could not be looked at - rather than
# as an error, because the platform already knows what to do with that.
AFNI_MEDIA_MAX_BYTES=
